# データベース（MySQL）
DATABASE_URL="mysql://user:password@localhost:3306/onetrack"

# JWT署名用シークレット（十分に長いランダム文字列）
JWT_SECRET=""

# メール送信（Resend）— パスワードリセットメールに使用
RESEND_API_KEY=""
EMAIL_FROM=""

# ゲストログイン用アカウント（seedの投入内容と一致させる）
GUEST_EMAIL="guest@example.com"
GUEST_PASSWORD=""

# サイトURL（メール内リンクなどに使用）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# LINE Messaging API（通知機能・アカウント連携）
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=""
